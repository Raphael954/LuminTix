<section class="success-stage">
  <div class="container">
    <div class="success-panel">
      <span class="success-icon"><i data-lucide="badge-check"></i></span>
      <span class="eyebrow">Payment confirmed</span>
      <h1>Your tickets are ready.</h1>
      <p><strong><%= order.quantity %></strong> <%= order.ticket_type %> ticket<%= order.quantity === 1 ? '' : 's' %> for <strong><%= order.event_snapshot.title %></strong>.</p>
      <div class="order-code"><span>Order</span><strong><%= order.order_code %></strong></div>
      <a class="btn btn-accent btn-lg" href="/orders/<%= order.public_token %>/tickets.zip">
        <i data-lucide="download"></i>
        <span>Download ticket ZIP</span>
      </a>
      <p class="muted-copy">A recovery copy is also queued for <%= order.customer_email %>.</p>
    </div>
  </div>
</section>
