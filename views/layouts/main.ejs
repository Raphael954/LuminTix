<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title ? `${title} | ${brandName}` : brandName %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body class="<%= currentPath.startsWith('/admin') ? 'admin-body' : '' %>">
    <nav class="navbar navbar-expand-lg app-navbar sticky-top">
      <div class="container">
        <a class="navbar-brand brand-mark" href="/">
          <span class="brand-icon"><i data-lucide="ticket"></i></span>
          <span><%= brandName %></span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
            <li class="nav-item">
              <a class="nav-link <%= helpers.activeClass(currentPath, '/events') %>" href="/events">Events</a>
            </li>
            <% navCategories.slice(0, 4).forEach((category) => { %>
              <li class="nav-item">
                <a class="nav-link" href="/category/<%= category.slug %>"><%= category.name %></a>
              </li>
            <% }) %>
            <li class="nav-item">
              <a class="nav-link <%= helpers.activeClass(currentPath, '/admin') %>" href="/admin">Admin</a>
            </li>
            <% if (admin) { %>
              <li class="nav-item">
                <form method="post" action="/admin/logout" class="d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm btn-ghost" type="submit">
                    <i data-lucide="log-out"></i>
                    <span>Sign out</span>
                  </button>
                </form>
              </li>
            <% } else { %>
              <li class="nav-item">
                <a class="btn btn-sm btn-accent" href="/events">
                  <i data-lucide="search"></i>
                  <span>Find Tickets</span>
                </a>
              </li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>

    <% if (flash) { %>
      <div class="container flash-wrap">
        <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
          <%= flash.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    <% } %>

    <main>
      <%- body %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="row g-4 align-items-start">
          <div class="col-lg-4">
            <a class="brand-mark footer-brand" href="/">
              <span class="brand-icon"><i data-lucide="ticket"></i></span>
              <span><%= brandName %></span>
            </a>
            <p class="footer-copy">A modern request-first ticketing experience for curated entertainment, sports, movies, music, concerts, and nightlife.</p>
          </div>
          <div class="col-6 col-lg-2">
            <h2 class="footer-title">Explore</h2>
            <a href="/events">All events</a>
            <% navCategories.slice(0, 3).forEach((category) => { %>
              <a href="/category/<%= category.slug %>"><%= category.name %></a>
            <% }) %>
          </div>
          <div class="col-6 col-lg-2">
            <h2 class="footer-title">Manage</h2>
            <a href="/admin">Dashboard</a>
            <a href="/admin/events">Events</a>
            <a href="/admin/requests">Requests</a>
          </div>
          <div class="col-lg-4">
            <h2 class="footer-title">Concierge booking</h2>
            <p class="footer-copy">Every request becomes a WhatsApp conversation with the details pre-filled, so your team can confirm availability personally.</p>
          </div>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="/js/app.js"></script>
  </body>
</html>
