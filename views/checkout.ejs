<section class="page-hero compact">
  <div class="container">
    <span class="eyebrow">Secure checkout</span>
    <h1>Complete your order</h1>
    <p>Your tickets are issued immediately after Paystack confirms the payment.</p>
  </div>
</section>

<section class="section-band light">
  <div class="container">
    <div class="checkout-layout">
      <form class="checkout-form detail-panel" method="post" action="/api/payments/initialize" data-checkout-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="source" value="<%= source %>">
        <% if (source === 'ticketmaster') { %>
          <input type="hidden" name="external_event_id" value="<%= event.external_event_id %>">
        <% } else { %>
          <input type="hidden" name="event_id" value="<%= event.id %>">
        <% } %>

        <div class="section-heading compact-heading">
          <div>
            <span class="eyebrow">Customer details</span>
            <h2>Who are the tickets for?</h2>
          </div>
          <span class="payment-badge"><i data-lucide="shield-check"></i> Paystack secured</span>
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="customer_name">Full name</label>
            <input class="form-control" id="customer_name" name="customer_name" required autocomplete="name">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="customer_email">Email</label>
            <input class="form-control" id="customer_email" name="customer_email" type="email" required autocomplete="email">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="customer_phone">Phone</label>
            <input class="form-control" id="customer_phone" name="customer_phone" required autocomplete="tel">
          </div>
          <div class="col-md-4">
            <label class="form-label" for="ticket_option_id">Ticket type</label>
            <% if (source === 'ticketmaster') { %>
              <input class="form-control" value="<%= event.ticket_type %>" readonly>
            <% } else { %>
              <select class="form-select" id="ticket_option_id" name="ticket_option_id" required data-ticket-option>
                <% ticketOptions.forEach((ticket) => { %>
                  <option value="<%= ticket.id %>" data-price="<%= ticket.price_usd_cents %>" <%= String(selectedTicketId) === String(ticket.id) ? 'selected' : '' %>>
                    <%= ticket.name %> - <%= ticket.price_label %>
                  </option>
                <% }) %>
              </select>
            <% } %>
          </div>
          <div class="col-md-2">
            <label class="form-label" for="quantity">Quantity</label>
            <input class="form-control" id="quantity" name="quantity" type="number" min="1" max="20" value="1" required data-quantity>
          </div>
        </div>

        <div class="checkout-action">
          <div>
            <span>Total</span>
            <strong data-checkout-total data-external-price="<%= event.unit_price_usd_cents || '' %>">
              <%= source === 'ticketmaster' ? event.price_label : ticketOptions[0]?.price_label %>
            </strong>
            <small>USD, card payment only</small>
          </div>
          <button class="btn btn-accent btn-lg" type="submit">
            <i data-lucide="credit-card"></i>
            <span>Continue to Paystack</span>
          </button>
        </div>
      </form>

      <aside class="sticky-summary checkout-summary">
        <img src="<%= event.image_url || event.hero_image_url %>" alt="<%= event.title %>">
        <div class="summary-body">
          <span class="eyebrow"><%= source === 'ticketmaster' ? 'Ticketmaster discovery' : 'LuminTix event' %></span>
          <h2><%= event.title %></h2>
          <p><i data-lucide="calendar"></i><%= helpers.formatDateTime(event.starts_at) %></p>
          <p><i data-lucide="map-pin"></i><%= event.venue_name || event.venue?.name %>, <%= event.city || event.venue?.city %></p>
          <p><i data-lucide="mail-check"></i>Instant download and email delivery</p>
        </div>
      </aside>
    </div>
  </div>
</section>
