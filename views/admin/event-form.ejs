<section class="admin-shell">
  <div class="container">
    <div class="admin-heading">
      <div>
        <span class="eyebrow">Admin</span>
        <h1><%= event.id ? 'Edit event' : 'Create event' %></h1>
      </div>
      <a class="btn btn-outline-dark" href="/admin/events">
        <i data-lucide="arrow-left"></i>
        <span>Back</span>
      </a>
    </div>

    <div class="admin-panel">
      <form method="post" action="<%= event.id ? `/admin/events/${event.id}` : '/admin/events' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3">
          <div class="col-lg-8">
            <label class="form-label" for="title">Title</label>
            <input class="form-control" id="title" name="title" value="<%= event.title || '' %>" required>
          </div>
          <div class="col-lg-4">
            <label class="form-label" for="slug">Slug</label>
            <input class="form-control" id="slug" name="slug" value="<%= event.slug || '' %>" placeholder="auto-generated">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="category_id">Category</label>
            <select class="form-select" id="category_id" name="category_id" required>
              <% categories.forEach((category) => { %>
                <option value="<%= category.id %>" <%= Number(event.category_id) === Number(category.id) ? 'selected' : '' %>><%= category.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="venue_id">Venue</label>
            <select class="form-select" id="venue_id" name="venue_id" required>
              <% venues.forEach((venue) => { %>
                <option value="<%= venue.id %>" <%= Number(event.venue_id) === Number(venue.id) ? 'selected' : '' %>><%= venue.name %> · <%= venue.city %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="starts_at">Starts at</label>
            <input class="form-control" id="starts_at" name="starts_at" type="datetime-local" value="<%= helpers.dateInputValue(event.starts_at) %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="ends_at">Ends at</label>
            <input class="form-control" id="ends_at" name="ends_at" type="datetime-local" value="<%= helpers.dateInputValue(event.ends_at) %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="status">Publish status</label>
            <select class="form-select" id="status" name="status">
              <% ['published', 'draft', 'postponed', 'cancelled'].forEach((status) => { %>
                <option value="<%= status %>" <%= (event.status || 'published') === status ? 'selected' : '' %>><%= helpers.statusLabel(status) %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="availability_status">Availability</label>
            <select class="form-select" id="availability_status" name="availability_status">
              <% ['request_only', 'available', 'limited', 'sold_out'].forEach((status) => { %>
                <option value="<%= status %>" <%= (event.availability_status || 'request_only') === status ? 'selected' : '' %>><%= helpers.statusLabel(status) %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label" for="summary">Summary</label>
            <input class="form-control" id="summary" name="summary" value="<%= event.summary || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label" for="description">Description</label>
            <textarea class="form-control" id="description" name="description" rows="5"><%= event.description || '' %></textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="image_url">Card image URL</label>
            <input class="form-control" id="image_url" name="image_url" value="<%= event.image_url || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="hero_image_url">Hero image URL</label>
            <input class="form-control" id="hero_image_url" name="hero_image_url" value="<%= event.hero_image_url || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="tags">Tags</label>
            <input class="form-control" id="tags" name="tags" value="<%= Array.isArray(event.tags) ? event.tags.join(', ') : '' %>" placeholder="VIP, Outdoor, Family">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="external_url">External URL</label>
            <input class="form-control" id="external_url" name="external_url" value="<%= event.external_url || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label" for="ticket_options">Ticket options</label>
            <textarea class="form-control monospace-field" id="ticket_options" name="ticket_options" rows="5" placeholder="Regular Access | From NGN 20,000 | Entry access | Request only"><%= ticketOptionsText %></textarea>
          </div>
          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" id="is_featured" name="is_featured" type="checkbox" <%= event.is_featured ? 'checked' : '' %>>
              <label class="form-check-label" for="is_featured">Feature on homepage</label>
            </div>
          </div>
          <div class="col-12 d-flex gap-2 flex-wrap">
            <button class="btn btn-accent" type="submit">
              <i data-lucide="save"></i>
              <span>Save event</span>
            </button>
            <% if (event.id) { %>
              <a class="btn btn-outline-dark" href="/events/<%= event.slug %>" target="_blank">
                <i data-lucide="external-link"></i>
                <span>View public page</span>
              </a>
            <% } %>
          </div>
        </div>
      </form>
      <% if (event.id) { %>
        <form class="delete-form" method="post" action="/admin/events/<%= event.id %>/delete">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-outline-danger" type="submit">
            <i data-lucide="trash-2"></i>
            <span>Delete event</span>
          </button>
        </form>
      <% } %>
    </div>
  </div>
</section>
