<section class="admin-shell">
  <div class="container">
    <div class="admin-heading">
      <div>
        <span class="eyebrow">Admin</span>
        <h1>Booking requests</h1>
      </div>
    </div>

    <div class="admin-tabs">
      <a href="/admin">Overview</a>
      <a href="/admin/events">Events</a>
      <a href="/admin/categories">Categories</a>
      <a href="/admin/venues">Venues</a>
      <a class="active" href="/admin/requests">Requests</a>
    </div>

    <div class="admin-panel">
      <div class="table-responsive">
        <table class="table admin-table align-middle">
          <thead>
            <tr>
              <th>Request</th>
              <th>Customer</th>
              <th>Event</th>
              <th>Ticket</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (!requests.length) { %>
              <tr>
                <td colspan="6" class="text-center muted-copy py-5">No booking requests yet.</td>
              </tr>
            <% } %>
            <% requests.forEach((request) => { %>
              <tr>
                <td><strong><%= request.request_code %></strong><br><span><%= helpers.formatDateTime(request.created_at) %></span></td>
                <td><strong><%= request.customer_name %></strong><br><span><%= request.customer_phone %></span></td>
                <td><%= request.event_title %></td>
                <td><%= request.ticket_name || 'To be advised' %><br><span>Qty <%= request.quantity %></span></td>
                <td><span class="status-pill status-<%= request.status %>"><%= helpers.statusLabel(request.status) %></span></td>
                <td>
                  <form method="post" action="/admin/requests/<%= request.id %>/status" class="request-status-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select class="form-select form-select-sm" name="status">
                      <% ['new', 'contacted', 'confirmed', 'closed'].forEach((status) => { %>
                        <option value="<%= status %>" <%= request.status === status ? 'selected' : '' %>><%= helpers.statusLabel(status) %></option>
                      <% }) %>
                    </select>
                    <button class="btn btn-sm btn-dark" type="submit">Save</button>
                  </form>
                </td>
              </tr>
              <tr class="request-message-row">
                <td colspan="6">
                  <pre><%= request.whatsapp_message %></pre>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
