<section class="admin-shell">
  <div class="container">
    <div class="admin-heading">
      <div>
        <span class="eyebrow">Admin</span>
        <h1>Dashboard</h1>
      </div>
      <a class="btn btn-accent" href="/admin/events/new">
        <i data-lucide="plus"></i>
        <span>New event</span>
      </a>
    </div>

    <div class="admin-tabs">
      <a class="active" href="/admin">Overview</a>
      <a href="/admin/events">Events</a>
      <a href="/admin/categories">Categories</a>
      <a href="/admin/venues">Venues</a>
      <a href="/admin/requests">Requests</a>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <span><i data-lucide="calendar-days"></i></span>
        <strong><%= stats.events %></strong>
        <p>Events</p>
      </div>
      <div class="stat-card">
        <span><i data-lucide="layout-grid"></i></span>
        <strong><%= stats.categories %></strong>
        <p>Categories</p>
      </div>
      <div class="stat-card">
        <span><i data-lucide="map"></i></span>
        <strong><%= stats.venues %></strong>
        <p>Venues</p>
      </div>
      <div class="stat-card">
        <span><i data-lucide="message-circle"></i></span>
        <strong><%= stats.requests %></strong>
        <p>Requests</p>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-7">
        <div class="admin-panel">
          <div class="admin-panel-heading">
            <h2>Recent events</h2>
            <a href="/admin/events">Manage</a>
          </div>
          <div class="table-responsive">
            <table class="table admin-table align-middle">
              <thead>
                <tr>
                  <th>Event</th>
                  <th>Date</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% events.forEach((event) => { %>
                  <tr>
                    <td><strong><%= event.title %></strong><br><span><%= event.venue_name %></span></td>
                    <td><%= helpers.formatDate(event.starts_at) %></td>
                    <td><span class="status-pill status-<%= event.availability_status %>"><%= helpers.statusLabel(event.availability_status) %></span></td>
                    <td><a class="btn btn-sm btn-outline-dark" href="/admin/events/<%= event.id %>/edit">Edit</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="admin-panel">
          <div class="admin-panel-heading">
            <h2>Latest requests</h2>
            <a href="/admin/requests">View all</a>
          </div>
          <div class="request-list-mini">
            <% if (!requests.length) { %>
              <p class="muted-copy">No requests yet.</p>
            <% } %>
            <% requests.forEach((request) => { %>
              <div>
                <strong><%= request.customer_name %></strong>
                <span><%= request.event_title %></span>
                <small><%= request.request_code %> · <%= helpers.statusLabel(request.status) %></small>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
