NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Required in production. Use at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret

# Set true only when serving over HTTPS.
COOKIE_SECURE=false

# Set true when deployed behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false

# Neon Postgres connection string. Leave blank to run with seeded in-memory data.
DATABASE_URL=

# Admin login used by local fallback and optional DB setup seed.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@lumin.local
ADMIN_PASSWORD=admin123

# WhatsApp number in international format, without + or spaces.
WHATSAPP_PHONE=2348000000000

# Optional public discovery source.
TICKETMASTER_API_KEY=
TICKETMASTER_COUNTRY_CODE=US
