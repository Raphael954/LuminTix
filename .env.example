NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Required in production. Use at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret

# Set true only when serving over HTTPS.
COOKIE_SECURE=false

# Set true when deployed behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false

# Neon Postgres connection string. Required for checkout and production.
DATABASE_URL=

# Admin login used by local fallback and optional DB setup seed.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@lumin.local
ADMIN_PASSWORD=admin123

# Ticketmaster Discovery API.
TICKETMASTER_API_KEY=
TICKETMASTER_COUNTRY_CODE=US
TICKETMASTER_CACHE_FRESH_SECONDS=3600
TICKETMASTER_CACHE_STALE_SECONDS=86400
TICKETMASTER_MAX_RETRIES=3
TICKETMASTER_MAX_INLINE_RETRY_MS=5000
TICKETMASTER_REQUEST_TIMEOUT_MS=10000

# Paystack USD card checkout.
PAYSTACK_SECRET_KEY=
PAYSTACK_REQUEST_TIMEOUT_MS=15000

# Resend ticket delivery.
RESEND_API_KEY=
EMAIL_FROM=LuminTix Tickets <tickets@example.com>
